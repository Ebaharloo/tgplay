#!/usr/bin/env python3
"""tgplay - one launcher for every source (AnimeGate + AnimeX + Telegram)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from tp.app import run             # noqa: E402

if __name__ == '__main__':
    if '--web-app' in sys.argv[1:]:              # Astryx in a real app window
        from tp.web.app_window import main as app_main
        sys.exit(run(app_main, 'tgplay'))

    if '--web' in sys.argv[1:]:                  # the Astryx UI in a browser
        from tp.web.run import main as web_main
        sys.exit(run(web_main, 'tgplay'))

    from tp.cli_all import main_all
    sys.exit(run(main_all, 'tgplay'))
